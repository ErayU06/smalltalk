# Bu dosyayı .env.local olarak kopyala ve doldur. .env.local git'e girmez.
# Anahtarlar SADECE geliştirme betiklerinde (scripts/) kullanılır; uygulama koduna,
# app.json'a veya EXPO_PUBLIC_* değişkenlerine asla konmaz.

# Faz 1b: Google Cloud Text-to-Speech hizmet hesabı anahtar dosyasının tam yolu
GOOGLE_APPLICATION_CREDENTIALS=

# Faz 4 (a) seçilirse: görsel üretim API anahtarı
IMAGE_API_KEY=
